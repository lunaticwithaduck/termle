{
  "name": "termle",
  "version": "1.0.0",
  "description": "Wordle in your terminal",
  "bin": {
    "termle": "./dist.js"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "esbuild index.ts --bundle --platform=node --format=esm --loader:.ts=ts --loader:.tsx=tsx --banner:js='#!/usr/bin/env node' --outfile=dist.js --external:ink --external:react && chmod +x dist.js",
    "start": "npm run typecheck && npm run build && node dist.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "ink": "^7.0.0",
    "react": "^19.2.5"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "esbuild": "^0.28.0",
    "typescript": "^6.0.2"
  }
}
